# 1. 设置控制台编码为 UTF-8，防止中文乱码
[Console]::OutputEncoding = [System.Text.Encoding]::UTF8

# 2. 退回到项目根目录 (相当于 cd ..)
Set-Location ..

Write-Host "🚀 开始构建基于DeepSeek和Llama对比的训练集..." -ForegroundColor Green

# 3. 检查文件是否存在 (Test-Path)
if (-not (Test-Path "output\win_train\correct.jsonl")) {
    Write-Host "❌ 错误: DeepSeek正确答案文件不存在: output\win_train\correct.jsonl" -ForegroundColor Red
    Write-Host "请确保DeepSeek已经运行完成并生成了正确答案文件"
    exit
}

if (-not (Test-Path "HPC\output\llama_wtqtrain\incorrect.jsonl")) {
    Write-Host "❌ 错误: Llama错误答案文件不存在: HPC\output\llama_wtqtrain\incorrect.jsonl" -ForegroundColor Red
    Write-Host "请确保Llama已经运行完成并已分类错误答案"
    exit
}

# 4. 运行 Python 脚本
# 注意：PowerShell 的换行符是反引号 ` (Esc键下方)，而不是 ^
python scripts\build_training_dataset.py `
    --deepseek_correct "output\win_train\correct.jsonl" `
    --qwen_incorrect "HPC\output\llama_wtqtrain\incorrect.jsonl" `
    --output_dir "output\win_train\training_data_llama" `
    --positive_name "positive_samples.jsonl" `
    --negative_name "negative_samples.jsonl"

# 5. 检查运行结果 ($LastExitCode)
if ($LastExitCode -eq 0) {
    Write-Host "`n✅ 训练集构建完成！" -ForegroundColor Cyan
    Write-Host "📁 输出文件:"
    Write-Host "   - 正向: output\win_train\training_data_llama\positive_samples.jsonl"
    Write-Host "   - 负向: output\win_train\training_data_llama\negative_samples.jsonl"
    
    Write-Host "`n📊 统计信息:"
    if (Test-Path "output\win_train\training_data_llama\training_stats.json") {
        Get-Content "output\win_train\training_data_llama\training_stats.json"
    }
} else {
    Write-Host "❌ 训练集构建失败！" -ForegroundColor Red
    exit
}